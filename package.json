{
  "name": "ringback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "build": "vite build --config apps/web/vite.config.ts && tsx scripts/bundle-workflows.ts && tsx scripts/build-runtime.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --reporter=default --reporter=json --outputFile=artifacts/tests/results.json",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "doctor": "tsx scripts/doctor.ts",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "eval:smoke": "tsx eval/run.ts --smoke",
    "eval:full": "tsx eval/run.ts",
    "demo:chaos": "tsx scripts/chaos.ts",
    "live:verify": "tsx scripts/live-verify.ts",
    "e2e": "playwright test",
    "start": "tsx scripts/supervisor.ts",
    "setup": "tsx scripts/setup.ts",
    "format": "prettier --write apps packages scripts eval tests *.ts *.json render.yaml",
    "cost": "tsx scripts/cost-model.ts",
    "setup:mongo": "tsx scripts/setup-mongo.ts",
    "smoke": "tsx scripts/smoke.ts",
    "eval:report": "tsx scripts/report-eval.ts",
    "audit:security": "tsx scripts/security-audit.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^4.3.1",
    "@mastra/core": "^1.78.0",
    "@sentry/node": "^11.8.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/testing": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "luxon": "^3.7.2",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mastra/mcp-docs-server": "^1.3.8",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@swc/core": "1.11.24"
  }
}
